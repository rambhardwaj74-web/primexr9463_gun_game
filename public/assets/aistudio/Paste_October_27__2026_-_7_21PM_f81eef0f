// --- MAP & SCENERY GENERATOR ---
function generateMap() {
  buildings.forEach(b => scene.remove(b.mesh));
  jumpPads.forEach(j => scene.remove(j.mesh));
  placedWalls.forEach(w => scene.remove(w.mesh));
  sceneryProps.forEach(p => scene.remove(p));
  buildings = []; jumpPads = []; placedWalls = []; sceneryProps = [];

  // 1. Build Multi-Elevation Rough 3D Terrain
  if (terrainMesh) scene.remove(terrainMesh);
  const terrainGeo = new THREE.PlaneGeometry(320, 320, 160, 160);
  terrainGeo.rotateX(-Math.PI / 2);

  const pos = terrainGeo.attributes.position;
  for (let i = 0; i < pos.count; i++) {
    const vx = pos.getX(i), vz = pos.getZ(i);
    pos.setY(i, getTerrainHeight(vx, vz));
  }
  terrainGeo.computeVertexNormals();

  const terrainMat = createTerrainShaderMaterial();
  terrainMesh = new THREE.Mesh(terrainGeo, terrainMat);
  terrainMesh.receiveShadow = true;
  scene.add(terrainMesh);

  // 2. Spawn Trees & Rocky Outcrops
  for (let i = 0; i < 45; i++) {
    const rx = (Math.random() - 0.5) * 220, rz = (Math.random() - 0.5) * 220;
    if (Math.hypot(rx, rz) < 16) continue;
    const tree = createPineTree(rx, rz);
    scene.add(tree); sceneryProps.push(tree);
  }
  for (let i = 0; i < 35; i++) {
    const rx = (Math.random() - 0.5) * 220, rz = (Math.random() - 0.5) * 220;
    if (Math.hypot(rx, rz) < 14) continue;
    const rock = createBoulder(rx, rz);
    scene.add(rock); sceneryProps.push(rock);
  }

  // 3. Spawn Map Buildings
  let count = 0, minH = 4, maxH = 8, widthRange = 5;
  if (selectedMapType === 0) { count = 8; minH = 3; maxH = 6; widthRange = 4; }
  else if (selectedMapType === 1) { count = 50; minH = 16; maxH = 42; widthRange = 10; }
  else if (selectedMapType === 2) { count = 26; minH = 8; maxH = 20; widthRange = 7; }

  const bTex = createBuildingTexture();
  const mat = new THREE.MeshStandardMaterial({ map: bTex, roughness: 0.28, metalness: 0.45, envMapIntensity: 1.1 });
  const windowMat = new THREE.MeshStandardMaterial({ color: 0x00ffcc, emissive: 0x00ffcc, emissiveIntensity: 0.9, transparent: true, opacity: 0.75 });
  const ladderMat = new THREE.MeshStandardMaterial({ color: 0xffd700, emissive: 0xffaa00, emissiveIntensity: 0.4, metalness: 0.7, roughness: 0.3 });

  for(let i = 0; i < count; i++) {
    const w = 5 + Math.random() * widthRange;
    const h = minH + Math.random() * (maxH - minH);
    const d = 5 + Math.random() * widthRange;
    const bx = (Math.random() - 0.5) * 170;
    const bz = (Math.random() - 0.5) * 170;
    if(Math.hypot(bx, bz) < 15) continue;

    const groundBaseY = getTerrainHeight(bx, bz);
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
    mesh.position.set(bx, groundBaseY + h / 2, bz);
    mesh.castShadow = true; mesh.receiveShadow = true;
    scene.add(mesh);

    const topGlow = new THREE.Mesh(new THREE.BoxGeometry(w + 0.1, 0.25, d + 0.1), windowMat);
    topGlow.position.set(0, h / 2, 0); mesh.add(topGlow);

    const ladderStrip = new THREE.Mesh(new THREE.BoxGeometry(0.8, h, 0.1), ladderMat);
    ladderStrip.position.set(0, 0, d/2 + 0.05); mesh.add(ladderStrip);

    buildings.push({
      mesh,
      xMin: bx - w/2, xMax: bx + w/2,
      zMin: bz - d/2, zMax: bz + d/2,
      baseY: groundBaseY,
      height: groundBaseY + h
    });

    if (h > 12 && Math.random() > 0.4) {
      const padGeo = new THREE.CylinderGeometry(1.2, 1.2, 0.2, 16);
      const padMat = new THREE.MeshBasicMaterial({ color: 0xffd700 });
      const padMesh = new THREE.Mesh(padGeo, padMat);
      const px = bx + (Math.random() > 0.5 ? w/2 + 2 : -w/2 - 2);
      const pz = bz + (Math.random() > 0.5 ? d/2 + 2 : -d/2 - 2);
      const py = getTerrainHeight(px, pz) + 0.1;
      padMesh.position.set(px, py, pz);
      scene.add(padMesh);
      jumpPads.push({ mesh: padMesh, x: px, z: pz, y: py });
    }
  }
}

// --- ENGINE INIT ---
function init() {
  const canvas = document.getElementById("gameCanvas");
  renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: "high-performance", alpha: false });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.25;
  renderer.outputEncoding = THREE.sRGBEncoding;

  scene = new THREE.Scene();
  scene.background = new THREE.Color(0x03060f);
  scene.fog = new THREE.FogExp2(0x03060f, 0.0095);

  camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 600);
  scene.add(camera);

  // Atmospheric Star Dome
  const starGeo = new THREE.BufferGeometry();
  const starPositions = [];
  for(let i=0; i<1200; i++) {
    const theta = Math.random() * Math.PI * 2, phi = Math.acos(Math.random() * 2 - 1);
    const r = 400;
    starPositions.push(r * Math.sin(phi) * Math.cos(theta), r * Math.sin(phi) * Math.sin(theta), r * Math.cos(phi));
  }
  starGeo.setAttribute('position', new THREE.Float32BufferAttribute(starPositions, 3));
  const starMat = new THREE.PointsMaterial({ color: 0xa0d8ff, size: 1.8, transparent: true, opacity: 0.85, sizeAttenuation: true });
  scene.add(new THREE.Points(starGeo, starMat));

  // Improved multi-light setup for richer shading
  scene.add(new THREE.AmbientLight(0x1a2035, 0.55));
  const hemi = new THREE.HemisphereLight(0x4060a0, 0x0a0c14, 0.55);
  scene.add(hemi);

  const sun = new THREE.DirectionalLight(0x00ffcc, 1.05);
  sun.position.set(60, 130, 50);
  sun.castShadow = true;
  sun.shadow.mapSize.width = 2048; sun.shadow.mapSize.height = 2048;
  sun.shadow.camera.near = 10;
  sun.shadow.camera.far = 300;
  sun.shadow.camera.left = -120; sun.shadow.camera.right = 120;
  sun.shadow.camera.top = 120; sun.shadow.camera.bottom = -120;
  sun.shadow.bias = -0.0005;
  scene.add(sun);

  // Soft fill / rim light for depth
  const fill = new THREE.DirectionalLight(0xff3080, 0.28);
  fill.position.set(-40, 30, -60);
  scene.add(fill);

  const pointGlow = new THREE.PointLight(0x00ffcc, 0.45, 80);
  pointGlow.position.set(0, 25, 0);
  scene.add(pointGlow);

  const zoneGeo = new THREE.CylinderGeometry(zoneRadius, zoneRadius, 90, 64, 1, true);
  const zoneMat = new THREE.MeshBasicMaterial({
    color: 0xff0055, side: THREE.DoubleSide, transparent: true, opacity: 0.22,
    depthWrite: false, blending: THREE.AdditiveBlending
  });
  zoneMesh = new THREE.Mesh(zoneGeo, zoneMat); zoneMesh.position.y = 45; scene.add(zoneMesh);

  // FPS Viewmodel
  gunGroup = new THREE.Group();
  camera.add(gunGroup);
  buildGunMesh();
  buildMedkitMesh();

  const ghostGeo = new THREE.BoxGeometry(3.5, 2.8, 0.35);
  const ghostMat = new THREE.MeshBasicMaterial({ color: 0x00ffcc, transparent: true, opacity: 0.4 });
  ghostWallMesh = new THREE.Mesh(ghostGeo, ghostMat);
  ghostWallMesh.visible = false;
  scene.add(ghostWallMesh);

  buildCompassRibbon();
  window.addEventListener('resize', onWindowResize);
  setupInputs();
}

function buildMedkitMesh() {
  medkitGroup = new THREE.Group();
  const caseMat = new THREE.MeshStandardMaterial({ color: 0x1a2130, metalness: 0.7, roughness: 0.3 });
  const stimFluidMat = new THREE.MeshStandardMaterial({ color: 0x00ff88, emissive: 0x00ff88, emissiveIntensity: 0.85 });

  const stimBody = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, 0.24, 16), caseMat);
  stimBody.rotation.x = Math.PI / 3; medkitGroup.add(stimBody);
  const fluidChamber = new THREE.Mesh(new THREE.CylinderGeometry(0.032, 0.032, 0.14, 16), stimFluidMat);
  stimBody.add(fluidChamber);

  medkitGroup.position.set(0, -0.6, -0.4); medkitGroup.visible = false;
  camera.add(medkitGroup);
}

function switchSlot(slotIdx) {
  if(slotIdx === currentSlotIdx || isReloading || isHealing) return;
  if (buildMode) toggleBuildMode(false);
  currentSlotIdx = slotIdx;
  buildGunMesh();
  updateHUD();
}

function toggleBuildMode(forceState = null) {
  if (isHealing || isReloading || isSpectating) return;
  buildMode = forceState !== null ? forceState : !buildMode;
  if (buildMode) {
    gunGroup.visible = false;
    ghostWallMesh.visible = true;
    document.getElementById("buildPrompt").style.display = "block";
    document.getElementById("crosshairContainer").style.display = "none";
  } else {
    gunGroup.visible = true;
    ghostWallMesh.visible = false;
    document.getElementById("buildPrompt").style.display = "none";
    document.getElementById("crosshairContainer").style.display = "block";
  }
  updateHUD();
}

function placeWall() {
  if (wood < 10) return;
  wood -= 10;
  audio.playBuildWall();

  const wTex = createWoodTexture();
  const wallMat = new THREE.MeshStandardMaterial({ map: wTex, roughness: 0.6, metalness: 0.2 });
  const wallMesh = new THREE.Mesh(new THREE.BoxGeometry(3.5, 2.8, 0.35), wallMat);
  wallMesh.position.copy(ghostWallMesh.position);
  wallMesh.rotation.copy(ghostWallMesh.rotation);
  wallMesh.castShadow = true; wallMesh.receiveShadow = true;
  scene.add(wallMesh);

  const wallData = {
    mesh: wallMesh, hp: 200, maxHp: 200,
    xMin: wallMesh.position.x - 1.75, xMax: wallMesh.position.x + 1.75,
    zMin: wallMesh.position.z - 1.75, zMax: wallMesh.position.z + 1.75,
    baseY: wallMesh.position.y - 1.4,
    height: wallMesh.position.y + 1.4
  };
  placedWalls.push(wallData);
  buildings.push(wallData);
  updateHUD();
}

function useMedkit() {
  if (isHealing || isReloading || isSpectating || medkits <= 0) return;
  if (player.hp >= 100 && player.shield >= 100) return;
  if (buildMode) toggleBuildMode(false);

  isHealing = true; healTimer = 0;
  gunGroup.visible = false; medkitGroup.visible = true;
  audio.playMedkitUse();
  document.getElementById("healHud").style.display = "block";
  document.getElementById("healVignette").style.opacity = "1";
}

function buildCompassRibbon() {
  const ribbon = document.getElementById("compassRibbon");
  let str = "";
  for (let i = 0; i < 360; i += 15) {
    let tag = i.toString().padStart(3, '0');
    if (i === 0) tag = "N"; else if (i === 45) tag = "NE"; else if (i === 90) tag = "E";
    else if (i === 135) tag = "SE"; else if (i === 180) tag = "S"; else if (i === 225) tag = "SW";
    else if (i === 270) tag = "W"; else if (i === 315) tag = "NW";
    str += `<span style="display:inline-block; width:45px; text-align:center;">${tag}</span>`;
  }
  ribbon.innerHTML = str + str + str;
}

function updateCompass() {
  let deg = Math.round((currentYaw * (180 / Math.PI)) % 360);
  if (deg < 0) deg += 360;
  const offset = -(deg / 15) * 45;
  document.getElementById("compassRibbon").style.transform = `translateX(${offset - 360}px)`;
  document.getElementById("compassDegree").textContent = `${deg.toString().padStart(3, '0')}°`;
}

function addKillFeed(killer, victim, isPlayerKill = false) {
  const feed = document.getElementById("killFeed");
  const item = document.createElement("div");
  item.className = "kill-item";
  item.style.borderLeftColor = isPlayerKill ? "#00ffcc" : "#ff0055";
  item.textContent = `🎯 ${killer} eliminated ${victim}`;
  feed.appendChild(item);
  setTimeout(() => { if (item.parentNode) item.parentNode.removeChild(item); }, 4000);
}

function setupInputs() {
  document.addEventListener("keydown", e => {
    keys[e.code] = true;
    if(e.code === 'KeyR') reloadWeapon();
    if(e.code === 'Digit1') switchSlot(0);
    if(e.code === 'Digit2') switchSlot(1);
    if(e.code === 'Digit3') switchSlot(2);
    if(e.code === 'Digit4' || e.code === 'KeyH') useMedkit();
    if(e.code === 'KeyQ') toggleBuildMode();
  });
  document.addEventListener("keyup", e => keys[e.code] = false);

  document.addEventListener("mousedown", e => {
    audio.init();
    if(e.button === 0 && gameActive && !isSpectating) {
      if (buildMode) placeWall();
      else shoot();
    }
    if(e.button === 2 && gameActive && !isSpectating && !buildMode) {
      isRightMouseDown = true;
    }
  });

  document.addEventListener("mouseup", e => {
    if(e.button === 2) isRightMouseDown = false;
  });

  document.addEventListener("contextmenu", e => e.preventDefault());

  document.addEventListener("mousemove", e => {
    if(document.pointerLockElement === document.body && gameActive && !isSpectating) {
      const activeWepIdx = inventorySlots[currentSlotIdx];
      const gun = WEAPONS[activeWepIdx];
      const adsSensScale = 1.0 - adsProgress * (gun.scopeType === 'sniper' ? 0.75 : 0.45);
      const sens = 0.0022 * adsSensScale;
      
      rawYaw -= e.movementX * sens;
      rawPitch -= e.movementY * sens;
      rawPitch = Math.max(-Math.PI/2.2, Math.min(Math.PI/2.2, rawPitch));
    }
  });
}

function startGame() {
  audio.init();
  careerStats.matchesPlayed++;
  document.getElementById("mainScreen").style.display = "none";
  document.getElementById("hud").style.display = "flex";
  document.getElementById("crosshairContainer").style.display = "block";
  document.getElementById("spectatorOverlay").style.display = "none";

  if(!scene) init();
  generateMap();

  player.hp = 100; player.shield = 100; player.kills = 0;
  player.x = 0; player.z = 0;
  player.y = getTerrainHeight(0, 0) + 1.7;
  player.vx = 0; player.vy = 0; player.vz = 0;
  rawYaw = 0; rawPitch = 0; currentYaw = 0; currentPitch = 0;
  adsProgress = 0;
  
  slotAmmoClips = inventorySlots.map(wIdx => WEAPONS[wIdx].mag);
  slotAmmoReserves = [90, 120, 25];
  currentSlotIdx = 0;
  isReloading = false; isHealing = false; buildMode = false; isSpectating = false;

  buildGunMesh();

  bots.forEach(b => scene.remove(b.mesh));
  bots = [];
  for(let i=0; i<9; i++) {
    const rName = RANDOM_BOT_NAMES[i % RANDOM_BOT_NAMES.length];
    const botData = createHumanoidBot(rName);
    const rx = (Math.random() - 0.5) * 140, rz = (Math.random() - 0.5) * 140;
    const ry = getTerrainHeight(rx, rz);
    botData.mesh.position.set(rx, ry, rz);
    scene.add(botData.mesh);
    botData.hp = 100; botData.lastShoot = 0; botData.name = rName;
    botData.walkCycle = Math.random() * 10;
    bots.push(botData);
  }

  lootItems.forEach(l => scene.remove(l.mesh));
  lootItems = [];
  for(let i=0; i<24; i++) {
    const r = Math.random();
    let type = 'ammo', color = 0x00ffcc;
    if (r < 0.35) { type = 'money'; color = 0xffd700; }
    else if (r < 0.70) { type = 'wood'; color = 0xe69138; }
    else if (r < 0.85) { type = 'medkit'; color = 0x00ff88; }
    const mesh = new THREE.Mesh(new THREE.SphereGeometry(0.45, 8, 8), new THREE.MeshBasicMaterial({ color }));
    const lx = (Math.random() - 0.5) * 150, lz = (Math.random() - 0.5) * 150;
    const ly = getTerrainHeight(lx, lz) + 0.45;
    mesh.position.set(lx, ly, lz);
    scene.add(mesh);
    lootItems.push({ mesh, type });
  }

  zoneRadius = 95; zoneTargetRadius = 95; zoneTimer = 45;
  gameActive = true;
  document.body.requestPointerLock();
  
  lastFrame = performance.now();
  requestAnimationFrame(gameLoop);
}

function shoot() {
  if (isReloading || isHealing || buildMode) return;
  const now = performance.now();
  const activeWepIdx = inventorySlots[currentSlotIdx];
  const gun = WEAPONS[activeWepIdx];

  if (slotAmmoClips[currentSlotIdx] <= 0) { reloadWeapon(); return; }
  if(now - lastShoot < gun.rate) return;

  lastShoot = now;
  slotAmmoClips[currentSlotIdx]--;
  audio.playShoot(gun.cat, gun.scopeType === 'sniper');
  updateHUD();

  // Recoil kicks
  springRecoil.vel.z += gun.recoil * 3.2;
  springRecoil.vel.y += gun.recoil * 0.9;
  springRecoil.rotVel.x += gun.recoil * 3.0;
  springRecoil.rotVel.z += (Math.random() - 0.5) * gun.recoil * 1.5;

  cameraPunch.pitchVel += gun.recoil * 0.45;
  cameraPunch.yawVel += (Math.random() - 0.5) * gun.recoil * 0.25;

  muzzleFlash.material.opacity = 1;
  muzzlePointLight.intensity = 3.0;
  setTimeout(() => {
    muzzleFlash.material.opacity = 0;
    muzzlePointLight.intensity = 0;
  }, 45);

  // Eject Spent Brass Shell
  const shellGeo = new THREE.CylinderGeometry(0.012, 0.012, 0.045, 8);
  const shellMat = new THREE.MeshStandardMaterial({ color: 0xffd700, metalness: 0.95, roughness: 0.2 });
  const shellMesh = new THREE.Mesh(shellGeo, shellMat);
  const camPos = new THREE.Vector3(); camera.getWorldPosition(camPos);
  shellMesh.position.copy(camPos).add(new THREE.Vector3(0.2, -0.15, -0.3));
  scene.add(shellMesh);

  shells.push({
    mesh: shellMesh,
    vx: (Math.random() * 2 + 2) * (Math.cos(currentYaw) + Math.sin(currentYaw)*0.5),
    vy: Math.random() * 2 + 2.5,
    vz: (Math.random() * 2 + 2) * (Math.sin(currentYaw) - Math.cos(currentYaw)*0.5),
    rotX: Math.random() * 15, rotY: Math.random() * 15, life: 2.0
  });

  const gunWorldPos = new THREE.Vector3();
  camera.getWorldPosition(gunWorldPos);
  const forwardDir = new THREE.Vector3();
  camera.getWorldDirection(forwardDir);
  gunWorldPos.addScaledVector(forwardDir, 0.4);

  const raycaster = new THREE.Raycaster();
  raycaster.setFromCamera(new THREE.Vector2(0,0), camera);

  const shootableTargets = [
    terrainMesh,
    ...bots.map(b => b.mesh),
    ...placedWalls.map(w => w.mesh),
    ...buildings.map(b => b.mesh),
    ...sceneryProps
  ];
  const intersects = raycaster.intersectObjects(shootableTargets, true);

  let targetPoint = gunWorldPos.clone().addScaledVector(forwardDir, 100);

  if(intersects.length > 0) {
    targetPoint = intersects[0].point;
    let hitObject = intersects[0].object;

    let hitBot = bots.find(b => {
      let curr = hitObject;
      while(curr) { if(curr === b.mesh) return true; curr = curr.parent; }
      return false;
    });

    let hitWall = placedWalls.find(w => w.mesh === hitObject);

    if(hitBot && !hitBot.isDead) {
      const isHead = hitObject.parent === hitBot.headGroup;
      const finalDmg = isHead ? Math.round(gun.dmg * 1.85) : gun.dmg;
      hitBot.hp -= finalDmg;
      audio.playHit();
      spawnDamagePopup(targetPoint, finalDmg, isHead);

      const hm = document.getElementById("hitmarker");
      hm.style.display = "block"; setTimeout(() => hm.style.display = "none", 80);
      updateBotSprite(hitBot);

      if(hitBot.hp <= 0) {
        hitBot.isDead = true;
        player.kills++; careerStats.kills++;
        money += 450; wood += 30;
        if (Math.random() > 0.4) medkits = Math.min(5, medkits + 1);
        player.hp = Math.min(100, player.hp + 35);
        player.shield = Math.min(100, player.shield + 35);
        addKillFeed("YOU", hitBot.name, true);
        saveGame(false);
        updateHUD();
        checkVictory();
      }
    } else if(hitWall) {
      hitWall.hp -= gun.dmg;
      audio.playWoodHit();
      if(hitWall.hp <= 0) {
        scene.remove(hitWall.mesh);
        placedWalls = placedWalls.filter(w => w !== hitWall);
        buildings = buildings.filter(b => b !== hitWall);
      }
    }
  }

  // Tracer line
  const mat = new THREE.LineBasicMaterial({ color: gun.color, linewidth: 2, transparent: true, opacity: 1 });
  const geo = new THREE.BufferGeometry().setFromPoints([gunWorldPos, targetPoint]);
  const line = new THREE.Line(geo, mat);
  scene.add(line);
  tracerLines.push({ line, spawnTime: performance.now() });
}

function reloadWeapon() {
  if (isReloading || isHealing || buildMode) return;
  const activeWepIdx = inventorySlots[currentSlotIdx];
  const gun = WEAPONS[activeWepIdx];
  const needed = gun.mag - slotAmmoClips[currentSlotIdx];
  if(needed > 0 && slotAmmoReserves[currentSlotIdx] > 0) {
    isReloading = true;
    reloadTimer = 0;
    reloadAudioPhases = [false, false, false];
    document.getElementById("reloadHud").style.display = "block";
  }
}

function triggerSpectatorMode(killer) {
  if (isSpectating) return;
  isSpectating = true;
  spectateTimer = 5.0; killerBot = killer; spectateCamAngle = 0;

  if (isHealing) {
    isHealing = false;
    document.getElementById("healHud").style.display = "none";
    document.getElementById("healVignette").style.opacity = "0";
  }
  document.getElementById("crosshairContainer").style.display = "none";
  document.getElementById("climbPrompt").style.display = "none";
  document.getElementById("reloadHud").style.display = "none";
  
  document.getElementById("specKillerName").textContent = killer ? killer.name : "SAFE ZONE STORM";
  document.getElementById("spectatorOverlay").style.display = "flex";
}

// --- MAIN GAME LOOP ---
let lastFrame = performance.now();
function gameLoop(now) {
  if(!gameActive) return;
  requestAnimationFrame(gameLoop);

  const dt = Math.min((now - lastFrame) / 1000, 0.1);
  lastFrame = now;

  if (isSpectating) {
    updateSpectatorCamera(dt);
  } else {
    updatePlayerPhysics(dt);
    updateSpringRecoil(dt);
    updateDynamicADS(dt);
    updateReloadAnimation(dt);
    updateMedkitAnimation(dt);
    updateGhostWallPreview();
  }

  updateBots(dt);
  updateZone(dt);
  updateShells(dt);
  updateDamagePopups(dt);
  updateTracers(now);
  updateCompass();
  updateHUD();
  renderMinimap();

  // Animate terrain cyber grid shader
  if (terrainMesh && terrainMesh.material && terrainMesh.material.uniforms) {
    terrainMesh.material.uniforms.time.value = now * 0.001;
  }

  // Pulse animated weapon skin emissives
  if (gunGroup) {
    gunGroup.traverse(obj => {
      if (obj.material && obj.material.userData && obj.material.userData.pulseSkin) {
        const base = obj.material.userData.baseEmissiveInt || 0.4;
        const pulse = 0.65 + 0.35 * Math.sin(now * 0.004);
        obj.material.emissiveIntensity = base * pulse;
      }
    });
  }

  renderer.render(scene, camera);
}

// --- ROUGH TERRAIN MULTI-ELEVATION PHYSICS ---
function updatePlayerPhysics(dt) {
  // Look smoothing
  currentYaw += (rawYaw - currentYaw) * Math.min(1.0, 38.0 * dt);
  currentPitch += (rawPitch - currentPitch) * Math.min(1.0, 38.0 * dt);

  // Recoil Cam recovery
  cameraPunch.pitchVel += (-120.0 * cameraPunch.pitch - 16.0 * cameraPunch.pitchVel) * dt;
  cameraPunch.pitch += cameraPunch.pitchVel * dt;
  cameraPunch.yawVel += (-120.0 * cameraPunch.yaw - 16.0 * cameraPunch.yawVel) * dt;
  cameraPunch.yaw += cameraPunch.yawVel * dt;

  const targetSpeed = keys['ShiftLeft'] ? 12.0 : 7.8;
  let moveX = 0, moveZ = 0;
  if(keys['KeyW']) moveZ -= 1;
  if(keys['KeyS']) moveZ += 1;
  if(keys['KeyA']) moveX -= 1;
  if(keys['KeyD']) moveX += 1;

  let wishVx = 0, wishVz = 0;
  if (moveX !== 0 || moveZ !== 0) {
    const len = Math.hypot(moveX, moveZ);
    moveX /= len; moveZ /= len;
    const sin = Math.sin(currentYaw), cos = Math.cos(currentYaw);
    wishVx = (moveX * cos + moveZ * sin) * targetSpeed;
    wishVz = (moveZ * cos - moveX * sin) * targetSpeed;
  }

  const accel = player.onGround ? 55.0 : 14.0;
  const friction = player.onGround ? 12.0 : 1.5;

  if (moveX !== 0 || moveZ !== 0) {
    player.vx += (wishVx - player.vx) * Math.min(1.0, accel * dt);
    player.vz += (wishVz - player.vz) * Math.min(1.0, accel * dt);
  } else {
    player.vx -= player.vx * Math.min(1.0, friction * dt);
    player.vz -= player.vz * Math.min(1.0, friction * dt);
  }

  player.x += player.vx * dt;
  player.z += player.vz * dt;

  // Dynamic Camera Banking
  const localVx = player.vx * Math.cos(currentYaw) - player.vz * Math.sin(currentYaw);
  targetCameraRoll = -localVx * 0.0045;
  cameraRoll += (targetCameraRoll - cameraRoll) * Math.min(1.0, 10.0 * dt);

  camera.rotation.set(currentPitch + cameraPunch.pitch, currentYaw + cameraPunch.yaw, cameraRoll, 'YXZ');

  // Footsteps
  const horizSpeed = Math.hypot(player.vx, player.vz);
  if (player.onGround && horizSpeed > 1.0) {
    footstepTimer += dt * horizSpeed;
    if (footstepTimer > 3.8) {
      audio.playFootstep();
      footstepTimer = 0;
    }
  }

  // Multi-Elevation Ground & Obstacle Check
  let groundY = getTerrainHeight(player.x, player.z) + 1.7;
  let nearClimbable = false;

  buildings.forEach(b => {
    const nearX = player.x >= b.xMin - 0.8 && player.x <= b.xMax + 0.8;
    const nearZ = player.z >= b.zMin - 0.8 && player.z <= b.zMax + 0.8;
    if (nearX && nearZ && player.y < b.height + 1.7) {
      nearClimbable = true;
      if (keys['KeyW'] || keys['Space']) {
        player.vy = 8.5; player.onGround = false;
      }
    }
    if (player.x >= b.xMin && player.x <= b.xMax && player.z >= b.zMin && player.z <= b.zMax) {
      if (player.y >= b.height + 1.2) groundY = Math.max(groundY, b.height + 1.7);
    }
  });

  document.getElementById("climbPrompt").style.display = nearClimbable ? "block" : "none";

  jumpPads.forEach(jp => {
    if (Math.hypot(player.x - jp.x, player.z - jp.z) < 1.8 && player.onGround) {
      player.vy = 22.0; player.onGround = false;
    }
  });

  if(keys['Space'] && player.onGround) { player.vy = 7.0; player.onGround = false; }
  player.vy -= 18.5 * dt;
  player.y += player.vy * dt;

  if(player.y <= groundY) { 
    player.y = groundY; player.vy = 0; player.onGround = true; 
  }
  camera.position.set(player.x, player.y, player.z);

  // Loot collection
  lootItems.forEach((l, idx) => {
    if(Math.hypot(player.x - l.mesh.position.x, player.z - l.mesh.position.z) < 1.6) {
      if (l.type === 'money') money += 500;
      else if (l.type === 'wood') { wood += 25; audio.playWoodCollect(); }
      else if (l.type === 'medkit') { medkits = Math.min(5, medkits + 1); audio.playWoodCollect(); }
      else slotAmmoReserves[currentSlotIdx] += 45;
      scene.remove(l.mesh);
      lootItems.splice(idx, 1);
      saveGame(false);
    }
  });
}

function updateSpringRecoil(dt) {
  const kSpring = 180.0, dSpring = 18.0;
  springRecoil.vel.z += (-kSpring * springRecoil.pos.z - dSpring * springRecoil.vel.z) * dt;
  springRecoil.pos.z += springRecoil.vel.z * dt;
  springRecoil.vel.y += (-kSpring * springRecoil.pos.y - dSpring * springRecoil.vel.y) * dt;
  springRecoil.pos.y += springRecoil.vel.y * dt;
  springRecoil.rotVel.x += (-kSpring * springRecoil.rot.x - dSpring * springRecoil.rotVel.x) * dt;
  springRecoil.rot.x += springRecoil.rotVel.x * dt;
  springRecoil.rotVel.z += (-kSpring * springRecoil.rot.z - dSpring * springRecoil.rotVel.z) * dt;
  springRecoil.rot.z += springRecoil.rotVel.z * dt;
}

function updateDynamicADS(dt) {
  const activeWepIdx = inventorySlots[currentSlotIdx];
  const gun = WEAPONS[activeWepIdx];

  const targetAds = (isRightMouseDown && !isReloading && !isHealing && !buildMode) ? 1.0 : 0.0;
  adsProgress += (targetAds - adsProgress) * Math.min(1.0, 14.0 * dt);

  const targetFov = 75 + (gun.zoomFov - 75) * adsProgress;
  camera.fov = targetFov;
  camera.updateProjectionMatrix();

  const horizSpeed = Math.hypot(player.vx, player.vz);
  bobTimer += dt * (player.onGround && horizSpeed > 0.5 ? horizSpeed * 1.5 : 1.2);

  const bobScale = (1.0 - adsProgress * 0.85) * Math.min(1.5, horizSpeed / 8.0);
  const bobX = Math.cos(bobTimer * 0.5) * 0.012 * bobScale;
  const bobY = Math.sin(bobTimer) * 0.015 * bobScale;
  const bobRotZ = Math.cos(bobTimer * 0.5) * 0.018 * bobScale;

  const hipPos = new THREE.Vector3(0.24, -0.20, -0.45);
  const adsPos = (gun.scopeType === 'sniper' || gun.scopeType === 'tactical') 
    ? new THREE.Vector3(0.0, -0.16, -0.32) 
    : new THREE.Vector3(0.0, -0.14, -0.36);

  if (!isReloading && !isHealing && !buildMode) {
    gunGroup.position.x = hipPos.x * (1 - adsProgress) + adsPos.x * adsProgress + bobX;
    gunGroup.position.y = hipPos.y * (1 - adsProgress) + adsPos.y * adsProgress + bobY + springRecoil.pos.y;
    gunGroup.position.z = hipPos.z * (1 - adsProgress) + adsPos.z * adsProgress + springRecoil.pos.z;

    gunGroup.rotation.x = springRecoil.rot.x;
    gunGroup.rotation.z = bobRotZ + springRecoil.rot.z;

    const sniperScopeEl = document.getElementById("sniperScope");
    const tacticalScopeEl = document.getElementById("tacticalScope");
    const crosshairContEl = document.getElementById("crosshairContainer");

    if (gun.scopeType === 'sniper') {
      sniperScopeEl.style.opacity = (adsProgress > 0.7 ? (adsProgress - 0.7) / 0.3 : 0).toString();
      tacticalScopeEl.style.opacity = "0";
      gunGroup.visible = adsProgress < 0.9;
    } else if (gun.scopeType === 'tactical') {
      sniperScopeEl.style.opacity = "0";
      tacticalScopeEl.style.opacity = (adsProgress > 0.6 ? (adsProgress - 0.6) / 0.4 : 0).toString();
      gunGroup.visible = true;
    } else {
      sniperScopeEl.style.opacity = "0";
      tacticalScopeEl.style.opacity = "0";
      gunGroup.visible = true;
    }

    // Dynamic Reticle Spread
    crosshairContEl.style.opacity = Math.max(0, 1.0 - adsProgress * 2.5).toString();
    const spread = Math.round(horizSpeed * 1.6);
    document.getElementById("chTop").style.transform = `translateY(-${spread}px)`;
    document.getElementById("chBottom").style.transform = `translateY(${spread}px)`;
    document.getElementById("chLeft").style.transform = `translateX(-${spread}px)`;
    document.getElementById("chRight").style.transform = `translateX(${spread}px)`;
  }
}

function updateGhostWallPreview() {
  if (!buildMode) return;
  const forward = new THREE.Vector3();
  camera.getWorldDirection(forward);
  const targetPos = new THREE.Vector3(player.x, player.y - 0.3, player.z).addScaledVector(forward, 3.8);
  ghostWallMesh.position.copy(targetPos);
  ghostWallMesh.rotation.y = currentYaw;
  ghostWallMesh.material.color.setHex(wood >= 10 ? 0x00ffcc : 0xff0044);
}

function updateMedkitAnimation(dt) {
  if (!isHealing) return;
  healTimer += dt;
  const progress = Math.min(healTimer / HEAL_TIME, 1.0);
  document.getElementById("healBarFill").style.width = (progress * 100) + "%";

  if (progress >= 1.0) {
    isHealing = false; medkits--;
    player.hp = 100; player.shield = Math.min(100, player.shield + 50);
    medkitGroup.visible = false; gunGroup.visible = true;
    document.getElementById("healHud").style.display = "none";
    document.getElementById("healVignette").style.opacity = "0";
    saveGame(false);
    updateHUD();
  }
}

function updateReloadAnimation(dt) {
  if (!isReloading) return;
  reloadTimer += dt;
  const progress = Math.min(reloadTimer / RELOAD_TIME, 1.0);
  document.getElementById("reloadBarFill").style.width = (progress * 100) + "%";

  if (progress < 0.35 && !reloadAudioPhases[0]) {
    audio.playReloadMagOut(); reloadAudioPhases[0] = true;
  } else if (progress > 0.55 && progress < 0.70 && !reloadAudioPhases[1]) {
    audio.playReloadMagIn(); reloadAudioPhases[1] = true;
  } else if (progress >= 0.70 && !reloadAudioPhases[2]) {
    audio.playReloadBolt(); reloadAudioPhases[2] = true;
  }

  if (progress >= 1.0) {
    isReloading = false;
    document.getElementById("reloadHud").style.display = "none";
    const activeWepIdx = inventorySlots[currentSlotIdx];
    const gun = WEAPONS[activeWepIdx];
    const needed = gun.mag - slotAmmoClips[currentSlotIdx];
    const transfer = Math.min(needed, slotAmmoReserves[currentSlotIdx]);
    slotAmmoClips[currentSlotIdx] += transfer;
    slotAmmoReserves[currentSlotIdx] -= transfer;
    updateHUD();
  }
}

function updateShells(dt) {
  for (let i = shells.length - 1; i >= 0; i--) {
    const s = shells[i];
    s.life -= dt;
    s.mesh.position.x += s.vx * dt;
    s.mesh.position.z += s.vz * dt;
    s.vy -= 9.8 * dt;
    s.mesh.position.y += s.vy * dt;

    s.mesh.rotation.x += s.rotX * dt;
    s.mesh.rotation.y += s.rotY * dt;

    const floorY = getTerrainHeight(s.mesh.position.x, s.mesh.position.z);
    if (s.mesh.position.y <= floorY + 0.03) {
      s.mesh.position.y = floorY + 0.03;
      s.vy = -s.vy * 0.35;
      s.vx *= 0.6; s.vz *= 0.6;
    }

    if (s.life <= 0) {
      scene.remove(s.mesh);
      shells.splice(i, 1);
    }
  }
}

function updateDamagePopups(dt) {
  for (let i = floatingNumbers.length - 1; i >= 0; i--) {
    const f = floatingNumbers[i];
    f.life -= dt;
    f.sprite.position.y += f.vy * dt;
    f.sprite.material.opacity = Math.max(0, f.life / 0.8);
    f.sprite.quaternion.copy(camera.quaternion);
    if (f.life <= 0) {
      scene.remove(f.sprite);
      floatingNumbers.splice(i, 1);
    }
  }
}

function updateSpectatorCamera(dt) {
  spectateTimer -= dt;
  spectateCamAngle += dt * 0.95;
  document.getElementById("specTimerNum").textContent = Math.max(0, spectateTimer).toFixed(1);
  document.getElementById("specProgressFill").style.width = (Math.max(0, spectateTimer / 5.0) * 100) + "%";

  let targetPos = new THREE.Vector3(player.x, player.y, player.z);
  if (killerBot && killerBot.mesh && !killerBot.isDead) targetPos.copy(killerBot.mesh.position);
  else if (bots.find(b => !b.isDead)) targetPos.copy(bots.find(b => !b.isDead).mesh.position);

  const cx = targetPos.x + Math.sin(spectateCamAngle) * 4.4;
  const cz = targetPos.z + Math.cos(spectateCamAngle) * 4.4;
  camera.position.lerp(new THREE.Vector3(cx, targetPos.y + 2.4, cz), 0.12);
  camera.lookAt(targetPos.x, targetPos.y + 1.2, targetPos.z);

  if (spectateTimer <= 0) gameOver(false);
}

function updateTracers(now) {
  for (let i = tracerLines.length - 1; i >= 0; i--) {
    if (now - tracerLines[i].spawnTime > 60) {
      scene.remove(tracerLines[i].line);
      tracerLines.splice(i, 1);
    }
  }
}

function updateBots(dt) {
  const now = performance.now();
  bots.forEach(b => {
    if (b.isDead) {
      if (b.deathProgress < 1.0) {
        b.deathProgress += dt * 3.0;
        b.mesh.rotation.x = -Math.PI / 2 * Math.min(1.0, b.deathProgress);
        b.mesh.position.y = Math.max(getTerrainHeight(b.mesh.position.x, b.mesh.position.z) + 0.15, b.mesh.position.y - dt * 2.5);
        b.nameSprite.visible = false;
      }
      return;
    }

    // Ground conformation
    const terrainGroundY = getTerrainHeight(b.mesh.position.x, b.mesh.position.z);
    b.mesh.position.y = terrainGroundY;

    const dist = Math.hypot(player.x - b.mesh.position.x, player.z - b.mesh.position.z);
    b.nameSprite.quaternion.copy(camera.quaternion);

    if(dist < 48 && !isSpectating) {
      b.mesh.lookAt(player.x, terrainGroundY, player.z);
      if(dist > 9) {
        b.mesh.translateZ(3.4 * dt);
        b.walkCycle += dt * 8.0;
        b.leftLeg.rotation.x = Math.sin(b.walkCycle) * 0.6;
        b.rightLeg.rotation.x = -Math.sin(b.walkCycle) * 0.6;
      } else if(now - b.lastShoot > 1150) {
        b.lastShoot = now;
        audio.play3DBotShoot(b.mesh.position, { x: player.x, z: player.z });
        b.bFlash.material.opacity = 1;
        setTimeout(() => b.bFlash.material.opacity = 0, 50);

        const di = document.getElementById("damageIndicator");
        di.style.borderColor = "rgba(255, 0, 85, 0.8)";
        di.style.opacity = "1";
        setTimeout(() => di.style.opacity = "0", 300);

        const dmg = 9;
        if(player.shield > 0) player.shield = Math.max(0, player.shield - dmg);
        else player.hp = Math.max(0, player.hp - dmg);

        if(player.hp <= 0 && !isSpectating) triggerSpectatorMode(b);
      }
    }
  });
}

function updateZone(dt) {
  zoneTimer -= dt;
  if(zoneTimer <= 0) { zoneTimer = 30; zoneTargetRadius = Math.max(10, zoneRadius - 25); }
  if(zoneRadius > zoneTargetRadius) {
    zoneRadius -= 2.0 * dt;
    zoneMesh.scale.set(zoneRadius / 95, 1, zoneRadius / 95);
  }
  if (!isSpectating) {
    const dist = Math.hypot(player.x - zoneCenter.x, player.z - zoneCenter.y);
    if(dist > zoneRadius) {
      player.hp -= 2.5 * dt;
      if(player.hp <= 0 && !isSpectating) triggerSpectatorMode(null);
    }
  }
}

function updateHUD() {
  const activeBots = bots.filter(b => !b.isDead).length;
  document.getElementById("aliveCount").textContent = activeBots + 1;
  document.getElementById("killCount").textContent = player.kills;
  document.getElementById("hudWood").textContent = wood;
  document.getElementById("hudMoney").textContent = "$" + money.toLocaleString();
  document.getElementById("zoneTimer").textContent = `00:${Math.max(0, Math.floor(zoneTimer)).toString().padStart(2,'0')}`;
  document.getElementById("hpFill").style.width = Math.max(0, player.hp) + "%";
  document.getElementById("shieldFill").style.width = Math.max(0, player.shield) + "%";

  document.getElementById("invMedkitCount").textContent = `x${medkits} ➕`;
  document.getElementById("invBuildCount").textContent = buildMode ? "ACTIVE 🔨" : "WALL 🧱";
  document.getElementById("invSlotBuild").className = `inv-slot build-slot ${buildMode ? 'active' : ''}`;
  
  document.getElementById("bloodVignette").style.opacity = (player.hp < 35 && !isSpectating) ? ((35 - player.hp) / 35).toString() : "0";
  document.getElementById("ammoClip").textContent = slotAmmoClips[currentSlotIdx];
  document.getElementById("ammoReserve").textContent = slotAmmoReserves[currentSlotIdx];

  [0, 1, 2].forEach(idx => {
    const wIdx = inventorySlots[idx];
    const elName = document.getElementById(`invName${idx}`);
    const elSlot = document.getElementById(`invSlot${idx}`);
    if(elName) elName.textContent = WEAPONS[wIdx].name;
    if(elSlot) elSlot.className = `inv-slot ${idx === currentSlotIdx && !buildMode ? 'active' : ''}`;
  });
}

function renderMinimap() {
  const mCanvas = document.getElementById("minimapCanvas");
  const ctx = mCanvas.getContext("2d");
  ctx.clearRect(0, 0, 130, 130);

  ctx.fillStyle = "#00ffcc"; ctx.beginPath(); ctx.arc(65, 65, 4, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = "#ff0055"; ctx.lineWidth = 2; ctx.beginPath();
  ctx.arc(65 + (zoneCenter.x - player.x)*0.45, 65 + (zoneCenter.y - player.z)*0.45, zoneRadius * 0.45, 0, Math.PI * 2);
  ctx.stroke();

  ctx.fillStyle = "#ff0055";
  bots.forEach(b => {
    if (b.isDead) return;
    const bx = 65 + (b.mesh.position.x - player.x) * 0.45;
    const bz = 65 + (b.mesh.position.z - player.z) * 0.45;
    if(bx > 0 && bx < 130 && bz > 0 && bz < 130) {
      ctx.beginPath(); ctx.arc(bx, bz, 3, 0, Math.PI * 2); ctx.fill();
    }
  });
}

function checkVictory() {
  if(bots.filter(b => !b.isDead).length === 0) {
    money += 1500; careerStats.wins++;
    saveGame(false);
    gameOver(true);
  }
}

function gameOver(isWin) {
  gameActive = false; isSpectating = false;
  if (document.exitPointerLock) document.exitPointerLock();
  
  document.getElementById("hud").style.display = "none";
  document.getElementById("crosshairContainer").style.display = "none";
  document.getElementById("spectatorOverlay").style.display = "none";
  document.getElementById("reloadHud").style.display = "none";
  document.getElementById("healHud").style.display = "none";
  document.getElementById("mainScreen").style.display = "flex";

  document.getElementById("screenTitle").textContent = isWin ? "VICTORY ROYALE!" : "ELIMINATED";
  saveGame(false);
  renderShop();
}

function onWindowResize() {
  if(!camera || !renderer) return;
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
}

// Initial Boot
loadGame(false);
renderShop();
</script>
