function importSaveFile(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(evt) {
    try {
      const data = JSON.parse(evt.target.result);
      if (typeof data.money === 'number' && Array.isArray(data.ownedGuns)) {
        money = data.money; wood = data.wood ?? 60; medkits = data.medkits ?? 2;
        ownedGuns = data.ownedGuns; inventorySlots = data.inventorySlots ?? [0, 8, 18];
        unlockedSkins = data.unlockedSkins ?? ['default']; equippedSkins = data.equippedSkins ?? {};
        selectedMapType = data.selectedMapType ?? 1;
        if (data.careerStats) careerStats = Object.assign(careerStats, data.careerStats);

        saveGame(false);
        selectMap(selectedMapType, false);
        renderShop();
        showToast("📤 IMPORT COMPLETED SUCCESSFULLY");
      }
    } catch (err) { showToast("❌ INVALID SAVE FILE"); }
  };
  reader.readAsText(file);
  e.target.value = '';
}

