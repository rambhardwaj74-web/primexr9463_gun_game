function getSavePayload() {
  return {
    money, wood, medkits,
    ownedGuns: [...ownedGuns],
    inventorySlots: [...inventorySlots],
    unlockedSkins: [...unlockedSkins],
    equippedSkins: { ...equippedSkins },
