  else if (isSniper) { bodyLen = 0.54; bodyH = 0.10; bodyW = 0.07; barrelLen = 0.58; barrelR = 0.024; }
  else if (isHeavy) { bodyLen = 0.52; bodyH = 0.14; bodyW = 0.12; barrelLen = 0.48; barrelR = 0.042; }

  // Lower & Upper Receiver
  const lowerReceiver = new THREE.Mesh(new THREE.BoxGeometry(bodyW, bodyH * 0.6, bodyLen), skinMat);
  gunRoot.add(lowerReceiver);

  const upperReceiver = new THREE.Mesh(new THREE.BoxGeometry(bodyW * 0.92, bodyH * 0.5, bodyLen * 0.95), skinMat);
  upperReceiver.position.set(0, bodyH * 0.5, -bodyLen * 0.02);
  gunRoot.add(upperReceiver);

  // Picatinny Optics Rail
  const rail = new THREE.Mesh(new THREE.BoxGeometry(bodyW * 0.75, 0.018, bodyLen * 0.85), railMat);
  rail.position.set(0, bodyH * 0.78, -bodyLen * 0.05);
  gunRoot.add(rail);

  // Barrel
  const barrel = new THREE.Mesh(new THREE.CylinderGeometry(barrelR, barrelR, barrelLen, 16), darkMetalMat);
  barrel.rotation.x = Math.PI / 2;
  barrel.position.set(0, bodyH * 0.25, -bodyLen / 2 - barrelLen / 2);
  gunRoot.add(barrel);

  if (!isPistol) {
    const shroudLen = barrelLen * 0.65;
    const shroud = new THREE.Mesh(new THREE.BoxGeometry(bodyW * 1.05, bodyH * 0.8, shroudLen), skinMat);
    shroud.position.set(0, bodyH * 0.25, -bodyLen / 2 - shroudLen / 2);
    gunRoot.add(shroud);

    const vent = new THREE.Mesh(new THREE.BoxGeometry(bodyW * 1.08, 0.016, shroudLen * 0.7), energyAccentMat);
    vent.position.set(0, bodyH * 0.25, -bodyLen / 2 - shroudLen / 2);
    gunRoot.add(vent);
  }

  const muzzleBrake = new THREE.Mesh(new THREE.CylinderGeometry(barrelR * 1.35, barrelR * 1.35, 0.08, 12), darkMetalMat);
  muzzleBrake.rotation.x = Math.PI / 2;
  muzzleBrake.position.set(0, bodyH * 0.25, -bodyLen / 2 - barrelLen);
  gunRoot.add(muzzleBrake);

  // Grip & Stock
  const grip = new THREE.Mesh(new THREE.BoxGeometry(bodyW * 0.7, 0.16, 0.065), gripRubberMat);
  grip.rotation.x = -0.32; grip.position.set(0, -bodyH * 0.7, bodyLen * 0.22);
  gunRoot.add(grip);

  if (isRifle || isSniper || isShotgun || isHeavy) {
    const bufferTube = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.018, 0.22, 12), darkMetalMat);
    bufferTube.rotation.x = Math.PI / 2; bufferTube.position.set(0, bodyH * 0.2, bodyLen / 2 + 0.1);
    gunRoot.add(bufferTube);

    const stockPlate = new THREE.Mesh(new THREE.BoxGeometry(bodyW * 0.85, 0.16, 0.06), skinMat);
    stockPlate.position.set(0, bodyH * 0.05, bodyLen / 2 + 0.22);
    gunRoot.add(stockPlate);
  }

  // Optics
  if (gun.scopeType === 'sniper') {
    const scopeGroup = new THREE.Group();
    scopeGroup.position.set(0, bodyH * 0.82 + 0.04, -0.04);
    const scopeTube = new THREE.Mesh(new THREE.CylinderGeometry(0.024, 0.024, 0.34, 16), darkMetalMat);
    scopeTube.rotation.x = Math.PI / 2; scopeGroup.add(scopeTube);
    const objBell = new THREE.Mesh(new THREE.CylinderGeometry(0.034, 0.024, 0.1, 16), skinMat);
    objBell.rotation.x = Math.PI / 2; objBell.position.z = -0.17; scopeGroup.add(objBell);
    const eyeBell = new THREE.Mesh(new THREE.CylinderGeometry(0.024, 0.03, 0.08, 16), skinMat);
    eyeBell.rotation.x = Math.PI / 2; eyeBell.position.z = 0.16; scopeGroup.add(eyeBell);
    gunRoot.add(scopeGroup);
  } else if (gun.scopeType === 'tactical' || isRifle) {
    const holoGroup = new THREE.Group();
    holoGroup.position.set(0, bodyH * 0.82 + 0.03, -0.06);
    const holoBase = new THREE.Mesh(new THREE.BoxGeometry(bodyW * 0.8, 0.025, 0.16), railMat);
    holoGroup.add(holoBase);
    const holoHood = new THREE.Mesh(new THREE.BoxGeometry(bodyW * 0.75, 0.05, 0.12), skinMat);
    holoHood.position.set(0, 0.032, 0); holoGroup.add(holoHood);
    gunRoot.add(holoGroup);
  }

  // Mag
  let magH = 0.22, magW = bodyW * 0.7, magD = 0.08;
  if (isPistol) { magH = 0.14; magD = 0.05; }
  const magMesh = new THREE.Mesh(new THREE.BoxGeometry(magW, magH, magD), darkMetalMat);
  magMesh.position.set(0, -magH * 0.55, 0.02);
  magMesh.rotation.x = 0.2;
  gunRoot.add(magMesh);

  if (targetGroup === gunGroup) {
    activeMagMesh = magMesh;
    const flashGeo = new THREE.ConeGeometry(0.09, 0.26, 8);
    const flashMat = new THREE.MeshBasicMaterial({ color: 0xffff33, transparent: true, opacity: 0 });
    muzzleFlash = new THREE.Mesh(flashGeo, flashMat);
    muzzleFlash.rotation.x = -Math.PI / 2;
    muzzleFlash.position.set(0, bodyH * 0.25, -bodyLen / 2 - barrelLen - 0.12);
    gunRoot.add(muzzleFlash);

    muzzlePointLight = new THREE.PointLight(0xffaa00, 0, 15);
    muzzleFlash.add(muzzlePointLight);

    const gloveMat = new THREE.MeshStandardMaterial({ color: 0x10141f, roughness: 0.7 });
    const sleeveMat = new THREE.MeshStandardMaterial({ color: 0x1a2133, roughness: 0.55 });
    fpsRightArm = new THREE.Group();
    const rForearm = new THREE.Mesh(new THREE.CylinderGeometry(0.048, 0.058, 0.42, 12), sleeveMat);
    rForearm.position.set(0.14, -0.16, 0.16); rForearm.rotation.set(0.6, -0.3, 0.4);
    fpsRightArm.add(rForearm);
    const rHand = new THREE.Mesh(new THREE.BoxGeometry(0.065, 0.075, 0.11), gloveMat);
    rHand.position.set(0.02, -0.02, 0.02); fpsRightArm.add(rHand);
    gunRoot.add(fpsRightArm);

    fpsLeftArm = new THREE.Group();
    const lForearm = new THREE.Mesh(new THREE.CylinderGeometry(0.048, 0.058, 0.46, 12), sleeveMat);
    lForearm.position.set(-0.22, -0.22, -0.05); lForearm.rotation.set(0.7, 0.4, -0.5);
    fpsLeftArm.add(lForearm);
    const lHand = new THREE.Mesh(new THREE.BoxGeometry(0.065, 0.075, 0.11), gloveMat);
    lHand.position.set(-0.02, -0.02, -0.15); fpsLeftArm.add(lHand);
    gunRoot.add(fpsLeftArm);

    gunRoot.position.set(0.24, -0.20, -0.45);
    document.getElementById("weaponName").textContent = gun.name;
  }

  targetGroup.add(gunRoot);
}

