// --- 3D SKINS STUDIO CUSTOMIZER ---
let studioScene, studioCamera, studioRenderer, studioGunGroup;
let studioActiveWepIdx = 0, studioActivePreviewSkin = 'default';
let studioDragging = false, studioPrevMouse = { x: 0, y: 0 };
let studioRot = { x: 0.2, y: -0.6 }, studioZoom = 1.35;

function initSkinsStudio() {
  const canvas = document.getElementById("skinPreviewCanvas");
  studioRenderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  studioRenderer.setSize(canvas.clientWidth, canvas.clientHeight);
  studioRenderer.toneMapping = THREE.ACESFilmicToneMapping;
  studioRenderer.toneMappingExposure = 1.25;

  studioScene = new THREE.Scene();
  studioCamera = new THREE.PerspectiveCamera(45, canvas.clientWidth / canvas.clientHeight, 0.1, 50);
  studioCamera.position.set(0, 0, studioZoom);

  studioScene.add(new THREE.AmbientLight(0xffffff, 0.7));
  const keyLight = new THREE.DirectionalLight(0x00ffcc, 1.3);
  keyLight.position.set(3, 4, 5); studioScene.add(keyLight);
  const fillLight = new THREE.DirectionalLight(0xff00aa, 0.9);
  fillLight.position.set(-4, -2, -3); studioScene.add(fillLight);

  studioGunGroup = new THREE.Group();
  studioScene.add(studioGunGroup);

  canvas.addEventListener('mousedown', e => { studioDragging = true; studioPrevMouse = { x: e.clientX, y: e.clientY }; });
  window.addEventListener('mouseup', () => studioDragging = false);
  window.addEventListener('mousemove', e => {
    if (!studioDragging) return;
    const dx = e.clientX - studioPrevMouse.x;
    const dy = e.clientY - studioPrevMouse.y;
    studioRot.y += dx * 0.012; studioRot.x += dy * 0.012;
    studioRot.x = Math.max(-Math.PI/2.5, Math.min(Math.PI/2.5, studioRot.x));
    studioPrevMouse = { x: e.clientX, y: e.clientY };
  });
  canvas.addEventListener('wheel', e => {
    e.preventDefault();
    studioZoom = Math.max(0.6, Math.min(2.4, studioZoom + e.deltaY * 0.0015));
    studioCamera.position.z = studioZoom;
  });
}

function openSkinsStudio() {
  document.getElementById("mainScreen").style.display = "none";
  document.getElementById("skinsStudioModal").style.display = "flex";
  document.getElementById("studioMoneyDisplay").textContent = "$" + money.toLocaleString();

  if (!studioRenderer) initSkinsStudio();

  const sel = document.getElementById("studioWepSelect");
  sel.innerHTML = "";
  WEAPONS.forEach((w, idx) => {
    const opt = document.createElement("option");
    opt.value = idx; opt.textContent = `${w.name} ${ownedGuns.includes(idx) ? '✓' : '(Not Owned)'}`;
    sel.appendChild(opt);
  });

  studioActiveWepIdx = inventorySlots[currentSlotIdx] || 0;
  sel.value = studioActiveWepIdx;
  studioActivePreviewSkin = equippedSkins[studioActiveWepIdx] || 'default';

  renderStudioUI();
  updateStudioPreview();
  requestAnimationFrame(studioRenderLoop);
}

function closeSkinsStudio() {
  document.getElementById("skinsStudioModal").style.display = "none";
  document.getElementById("mainScreen").style.display = "flex";
  buildGunMesh();
  renderShop();
}

function onStudioWeaponChange() {
  studioActiveWepIdx = parseInt(document.getElementById("studioWepSelect").value);
  studioActivePreviewSkin = equippedSkins[studioActiveWepIdx] || 'default';
  renderStudioUI();
  updateStudioPreview();
}

function renderStudioUI() {
  const grid = document.getElementById("studioSkinsGrid");
  grid.innerHTML = "";
  const currentEquipped = equippedSkins[studioActiveWepIdx] || 'default';

  SKINS_CATALOG.forEach(s => {
    const isUnlocked = unlockedSkins.includes(s.id);
    const isEquipped = currentEquipped === s.id;
    const isPreviewing = studioActivePreviewSkin === s.id;

    const card = document.createElement("div");
    card.className = `skin-card ${isPreviewing ? 'active-preview' : ''} ${isEquipped ? 'equipped-skin' : ''}`;
    card.onclick = () => { studioActivePreviewSkin = s.id; renderStudioUI(); updateStudioPreview(); };

    let btnHtml = "";
    if (isEquipped) btnHtml = `<button class="skin-btn skin-btn-equipped">EQUIPPED ✓</button>`;
    else if (isUnlocked) btnHtml = `<button class="skin-btn skin-btn-equip" onclick="equipSkin('${s.id}')">EQUIP SKIN</button>`;
    else btnHtml = `<button class="skin-btn skin-btn-buy" onclick="buySkin('${s.id}', ${s.cost})">UNLOCK ($${s.cost.toLocaleString()})</button>`;

    card.innerHTML = `
      <div>
        <div class="skin-title"><span>${s.icon}</span> ${s.name}</div>
        <div class="skin-desc">${s.desc}</div>
      </div>
      ${btnHtml}
    `;
    grid.appendChild(card);
  });

  const wep = WEAPONS[studioActiveWepIdx];
  const skin = SKINS_CATALOG.find(s => s.id === studioActivePreviewSkin);
  document.getElementById("studioPreviewWepName").textContent = `${wep.name} - ${skin.icon} ${skin.name}`;
}

function updateStudioPreview() {
  buildWeaponModel(studioActiveWepIdx, studioGunGroup, studioActivePreviewSkin);
}

function buySkin(skinId, cost) {
  if (money >= cost) {
    money -= cost; unlockedSkins.push(skinId);
    equippedSkins[studioActiveWepIdx] = skinId;
    studioActivePreviewSkin = skinId;
    audio.init(); saveGame(false);
    showToast(`🎨 UNLOCKED ${skinId.toUpperCase()} SKIN!`);
    document.getElementById("studioMoneyDisplay").textContent = "$" + money.toLocaleString();
    renderStudioUI(); updateStudioPreview();
  } else { showToast("❌ INSUFFICIENT FUNDS"); }
}

function equipSkin(skinId) {
  equippedSkins[studioActiveWepIdx] = skinId;
  studioActivePreviewSkin = skinId;
  saveGame(false);
  showToast(`✨ EQUIPPED ${skinId.toUpperCase()} SKIN`);
  renderStudioUI(); updateStudioPreview();
}

function studioRenderLoop() {
  if (document.getElementById("skinsStudioModal").style.display === "flex") {
    requestAnimationFrame(studioRenderLoop);
    studioGunGroup.rotation.y = studioRot.y;
    studioGunGroup.rotation.x = studioRot.x;
    studioCamera.position.z = studioZoom;
    studioRenderer.render(studioScene, studioCamera);
  }
}

