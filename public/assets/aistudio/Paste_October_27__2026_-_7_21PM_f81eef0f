function saveGame(notify = false) {
  try {
    localStorage.setItem(SAVE_STORAGE_KEY, JSON.stringify(getSavePayload()));
    if (notify) showToast("💾 PROGRESS SAVED SUCCESSFULLY");
  } catch (err) { if (notify) showToast("❌ SAVE FAILED"); }
}

function loadGame(notify = false) {
  try {
    const raw = localStorage.getItem(SAVE_STORAGE_KEY);
    if (!raw) return false;
    const data = JSON.parse(raw);
    if (typeof data.money === 'number') money = data.money;
    if (typeof data.wood === 'number') wood = data.wood;
    if (typeof data.medkits === 'number') medkits = data.medkits;
    if (Array.isArray(data.ownedGuns)) ownedGuns = data.ownedGuns;
    if (Array.isArray(data.inventorySlots)) inventorySlots = data.inventorySlots;
    if (Array.isArray(data.unlockedSkins)) unlockedSkins = data.unlockedSkins;
    if (data.equippedSkins) equippedSkins = Object.assign({}, data.equippedSkins);
    if (typeof data.selectedMapType === 'number') selectedMapType = data.selectedMapType;
    if (data.careerStats) careerStats = Object.assign(careerStats, data.careerStats);

    selectMap(selectedMapType, false);
    renderShop();
    if (notify) showToast("📂 SAVE LOADED SUCCESSFULLY");
    return true;
  } catch (err) { return false; }
}

