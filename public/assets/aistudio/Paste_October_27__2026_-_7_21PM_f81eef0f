<body>

<div id="cinematicVignette"></div>
<div id="saveToast">💾 GAME PROGRESS SAVED</div>

<!-- HUD -->
<div id="hud" style="display:none;">
  <div id="compassContainer">
    <div id="compassRibbon"></div>
    <div id="compassNeedle"></div>
    <div id="compassDegree">000°</div>
  </div>

  <div id="killFeed"></div>
  <div id="damageIndicator"></div>
  <div id="bloodVignette"></div>
  <div id="healVignette"></div>

